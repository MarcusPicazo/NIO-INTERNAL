# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key-server-only

# Private app sessions. Generate with: openssl rand -base64 48
NIMIO_SESSION_SECRET=replace-with-long-random-secret

# Optional emergency fallback for /admin/login.
# The main admin access is email + password created at /admin/setup.
ADMIN_ACCESS_TOKEN=

# Optional display metadata
NEXT_PUBLIC_APP_NAME=NIMIO LEVELS
